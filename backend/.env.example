# Copiá este archivo como .env y completá los valores reales (el .env NUNCA se sube a git)

NODE_ENV=development
PORT=3000

# Base de datos (SQL Server)
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
# En producción / servidor remoto: DB_ENCRYPT=true y DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Clave larga y aleatoria para firmar los JWT
JWT_SECRET=

# URLs públicas
FRONTEND_URL=http://localhost:5173
# URL pública https del backend, para el webhook de Mercado Pago (vacía en local = sin webhook)
BACKEND_URL=
# Orígenes que pueden llamar a la API (separados por coma). Si se omite, se usa FRONTEND_URL
CORS_ORIGINS=
# Cantidad de proxies delante del servidor (Azure App Service/Nginx: 1). Vacío en local
TRUST_PROXY=

# Mercado Pago (en producción usar las credenciales de producción, no las de prueba)
MERCADOPAGO_ACCESS_TOKEN=

# Resend (mails)
RESEND_API_KEY=
# Remitente: tiene que ser de un dominio verificado en Resend. Si se omite, usa onboarding@resend.dev
# (que solo puede enviar al email dueño de la cuenta de Resend)
EMAIL_FROM="Creaciones Alma <hola@creacionesalma.com.ar>"
# A dónde llegan las respuestas de los clientes
EMAIL_REPLY_TO=hola@creacionesalma.com.ar
ADMIN_EMAIL=

# Cloudinary (subida firmada de imágenes, solo admins). Están en el Dashboard de Cloudinary → API Keys.
# El API secret NUNCA va en el frontend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta donde se guardan las imágenes subidas desde el admin
CLOUDINARY_FOLDER=creaciones-alma

# Correo Argentino (MiCorreo). Producción: https://api.correoargentino.com.ar/micorreo/v1
CORREOARGENTINO_API_USER=
CORREOARGENTINO_API_PASSWORD=
CORREOARGENTINO_BASE_URL=https://apitest.correoargentino.com.ar/micorreo/v1
