# Copiá este archivo como .env.production (o .env.local) y completá la URL real del backend
VITE_API_URL=http://localhost:3000/api
# Dominio público del sitio, sin barra final. Se usa en canonical, sitemap.xml y robots.txt
VITE_SITE_URL=http://localhost:5173
# Analítica (opcional). Si quedan vacías no se carga ningún script de terceros
# Google Analytics 4: el "ID de medición" (G-XXXXXXXXXX)
VITE_GA_ID=
# Píxel de Meta para medir campañas de Instagram / Facebook (solo números)
VITE_META_PIXEL_ID=
